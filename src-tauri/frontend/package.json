{
  "name": "r-code-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-loopback.mjs",
    "dev": "node scripts/tauri-dev-server.mjs",
    "dev:vite": "vite",
    "test:dev-server": "node --test scripts/tauri-dev-server.test.mjs",
    "test:popover": "node --test scripts/popover-viewport.test.mjs",
    "build": "tsc && vite build",
    "build:demo": "tsc --noEmit && node scripts/build-demo.mjs",
    "qa:demo": "node ../../docs/ui/demo/qa.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright-core": "^1.54.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
