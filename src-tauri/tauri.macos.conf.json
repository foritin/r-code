{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.rcode.desktop",
  "app": {
    "windows": [
      {
        "title": "R-Code",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
