{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-Code",
  "version": "0.9.0",
  "identifier": "com.r-code.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "frontend",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "R-Code",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "R-Code Team",
    "copyright": "Copyright © 2026 R-Code Team",
    "shortDescription": "R-Code — session-first AI coding desktop app",
    "longDescription": "R-Code is a session-first desktop application for AI-assisted coding, built with Rust + Tauri.",
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/512x512.png",
      "../icons/icon.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "zh-CN"
        ]
      },
      "nsis": {
        "installerIcon": "../icons/icon.ico",
        "uninstallerIcon": "../icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/foritin/r-code/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMjdGRDcxQUU3QjYwNDMKUldSRFlIdXVjZjBuVEI2RjJGQ2RMUEFYSTZJN3VJVGRldFVlRnVNMUVUMTRCc3YzOU42Tks4aXcK"
    }
  }
}
