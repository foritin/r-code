{
  "schema": "r-code-plan-preregistration/v1",
  "provider_kind": "deepseek",
  "eligibility_profile_version": "deepseek-plan-v1",
  "capability": {
    "cases_per_category": 5,
    "categories": ["bugfix", "feature", "migration", "performance", "safety"],
    "arms": ["direct_agent", "plan_baseline", "plan_dual_track"],
    "records_expected": 75,
    "auto_suggestion_disabled": true,
    "isolation": "每个 (case_id, arm) 使用独立的 workspace / SQLite / session 目录 / runtime，随机化只作用于运行顺序"
  },
  "routing": {
    "probes_simple": 20,
    "probes_complex": 20,
    "records_expected": 40
  },
  "evidence": {
    "retry_count_max_per_record": 2,
    "non_dry_run_required": true,
    "positive_tokens_and_rounds_required": true,
    "frozen_pricing_required": true,
    "clean_commit_required": true
  },
  "gates": {
    "net_solved_gain_min": 4,
    "regressions_max": 1,
    "mcnemar_p_one_sided_max": 0.1,
    "unapproved_side_effects_max": 0,
    "simple_false_prompt_rate_max": 0.1,
    "complex_recall_rate_min": 0.8,
    "same_request_repeat_rate_max": 0.0,
    "dual_median_tokens_ratio_max": 1.2,
    "dual_p95_wall_time_ratio_max": 1.3
  },
  "failure_rules": {
    "missing_record": "fail",
    "duplicate_record": "fail",
    "shared_arm_state": "fail",
    "illegal_retry": "fail",
    "raw_artifact_unavailable": "fail",
    "provider_mismatch": "fail"
  }
}
