@@ -0,0 +1,6 @@
+export function redact(text) {
+  return String(text)
+    .replace(/Bearer\s+[A-Za-z0-9._-]+/gi, "Bearer [REDACTED]")
+    .replace(/(api[_-]?key["'=:\s]+)[A-Za-z0-9._-]+/gi, "$1[REDACTED]")
+    .replace(/\b[0-9a-f]{32,}\b/gi, "[REDACTED]");
+}
