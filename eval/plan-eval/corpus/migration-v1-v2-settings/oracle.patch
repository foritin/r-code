diff --git a/lib/migrate.js b/lib/migrate.js
new file mode 100644
index 0000000..d30b43e
--- /dev/null
+++ b/lib/migrate.js
@@ -0,0 +1,12 @@
+export function migrateSettings(v1) {
+  if (!v1 || v1.version === 2) return v1;
+  const { notify_email, notify_push, ...rest } = v1;
+  return {
+    ...rest,
+    version: 2,
+    notify: {
+      email: Boolean(notify_email),
+      push: Boolean(notify_push),
+    },
+  };
+}
