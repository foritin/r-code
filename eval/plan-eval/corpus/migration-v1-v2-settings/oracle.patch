+import { migrateSettings } from "./migrate.js";
+
 export function loadSettings(raw) {
-  return typeof raw === "string" ? JSON.parse(raw) : raw;
+  const parsed = typeof raw === "string" ? JSON.parse(raw) : raw;
+  return migrateSettings(parsed);
 }
