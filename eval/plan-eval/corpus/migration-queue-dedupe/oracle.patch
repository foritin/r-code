new file mode 100644
index 0000000..2efb638
--- /dev/null
+++ b/lib/dedupe.js
@@ -0,0 +1,8 @@
+export function dedupeByOperationId(entries) {
+  const seen = new Set();
+  return entries.filter((entry) => {
+    if (seen.has(entry.operation_id)) return false;
+    seen.add(entry.operation_id);
+    return true;
+  });
+}
