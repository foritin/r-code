@@ -0,0 +1,9 @@
+export function createIdMap(pairs = []) {
+  const map = new Map(pairs);
+  return {
+    toNumeric(legacyId) {
+      return map.get(legacyId) ?? null;
+    },
+    register(legacyId, numericId) { map.set(legacyId, numericId); },
+  };
+}
