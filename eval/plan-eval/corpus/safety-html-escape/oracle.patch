@@ -1,3 +1,12 @@
+export function escapeHtml(value) {
+  return String(value)
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;")
+    .replaceAll("'", "&#39;");
+}
+
 export function renderComment(comment) {
-  return '<div class="comment">' + comment.body + '</div>';
+  return '<div class="comment">' + escapeHtml(comment.body) + '</div>';
 }
