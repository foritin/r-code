{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://r-code.dev/schemas/harness-v1.schema.json",
  "title": "Harness plugin manifest (harness.json)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "apiMajor",
    "apiMinor",
    "displayName",
    "supportedPlatforms",
    "configSchema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Opaque harness identity; never parsed for meaning."
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the plugin package."
    },
    "apiMajor": {
      "type": "integer",
      "minimum": 1
    },
    "apiMinor": {
      "type": "integer",
      "minimum": 0
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "executable"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "windows-x64",
              "macos-arm64",
              "macos-x64",
              "linux-x64"
            ]
          },
          "executable": {
            "type": "string",
            "pattern": "^(?!/)[^:]+",
            "description": "Package-relative native executable path; no drive letters, no absolute paths, no '..' segments."
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supportedFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Advertised features (e.g. multi-turn-tools, plan-hitl, delegation). Informational; not a grant."
    },
    "requestedHostServices": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "host.model.stream",
          "host.tools.list",
          "host.tools.call",
          "host.process.open",
          "host.process.read",
          "host.process.write",
          "host.process.close",
          "host.context.read",
          "host.artifacts.put",
          "host.artifacts.read",
          "host.plan.publish",
          "host.plan.update",
          "host.questions.ask",
          "host.approvals.request",
          "host.children.spawn",
          "host.children.wait",
          "host.children.cancel",
          "host.verification.run",
          "host.checkpoint.save",
          "host.completion.propose"
        ]
      },
      "uniqueItems": true
    },
    "configSchema": {
      "type": "object",
      "description": "JSON Schema for plugin configuration values."
    },
    "processProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "framing"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "framing": {
            "type": "string",
            "enum": [
              "ndjson-rpc",
              "raw"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "requiresEffectFields": {
      "type": "boolean",
      "default": false,
      "description": "P19A (API v1.2): the package emits WorkUnit effect/network fields; requires apiMinor >= 2."
    },
    "requiresSingleProcess": {
      "type": "boolean",
      "default": false,
      "description": "P23 (API v1.3): the package declares that it never forks and never execs another image, so it requires the host's single-process guarantee; requires apiMinor >= 3. Absent means undeclared, which the host enforces as a contained tree (and refuses on macOS), never as a proven single process."
    }
  },
  "definitions": {
    "ProcessReadRequest": {
      "type": "object",
      "required": [
        "handle",
        "cursor",
        "maxBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "ProcessOutputFrame": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "sequence",
            "stream",
            "dataBase64"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "data"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "dataBase64": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "sequence",
            "stream"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "eof"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "sequence",
            "exitCode"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "exit"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "ProcessReadReply": {
      "type": "object",
      "required": [
        "frames",
        "nextCursor",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessOutputFrame"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0
        },
        "terminal": {
          "type": "boolean"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "WorkUnitEffectClass": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace-mutation",
        "dependency-preparation"
      ],
      "description": "P19A: the effect authority class of one WorkUnit. read-only is the conservative default."
    },
    "NetworkCeiling": {
      "type": "string",
      "enum": [
        "offline",
        "public-internet-client",
        "host-network"
      ],
      "description": "P19A: the network ceiling of one WorkUnit. offline is the conservative default; host-network is platform-incompatible in v1."
    }
  }
}
